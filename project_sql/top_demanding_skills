/* what are the most in demand skills for data analysis?
- join job posting to inner join table similar to query 2 
- identify the top 5 in demand skills for data  analysis
- focus on all job postings
-why? retrieves all the  top in demand skills in the job market for data analysis, provide insights for the top skills in demand for the job seekers.
 */

select skills, count( skills_job_dim.job_id) as demand_count , job_location, salary_year_avg, name

from job_postings_fact
 INNER JOIN skills_job_dim ON skills_job_dim.job_id = job_postings_fact.job_id
 inner JOIN skills_dim ON skills_job_dim.skill_id = skills_dim.skill_id
 inner join company_dim on company_dim. company_id = job_postings_fact.company_id and salary_year_avg IS NOT NULL
where
 job_title_short = 'Data Analyst' and job_work_from_home = 'True' 

 group by skills, job_location, job_location, salary_year_avg, name
 order by demand_count desc
limit 5 ;


